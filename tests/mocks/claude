#!/bin/bash
# Mock claude CLI for testing ralph.sh
# Behavior controlled by MOCK_CLAUDE_BEHAVIOR env var
# Phase detected via --allowed-tools argument

cat > /dev/null

ALLOWED_TOOLS=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --allowed-tools) ALLOWED_TOOLS="$2"; shift 2 ;;
    *) shift ;;
  esac
done

BEHAVIOR="${MOCK_CLAUDE_BEHAVIOR:-fail}"

# --- Rate limit handling (before phase detection) ---
if [[ "$BEHAVIOR" == "ratelimit" ]]; then
  COUNTER_FILE="$MOCK_RATELIMIT_COUNTER"
  COUNT=0
  [ -f "$COUNTER_FILE" ] && COUNT=$(cat "$COUNTER_FILE")
  COUNT=$((COUNT + 1))
  echo "$COUNT" > "$COUNTER_FILE"
  if [ "$COUNT" -le "${MOCK_RATELIMIT_FAIL_COUNT:-1}" ]; then
    echo "Error: 429 Too Many Requests - rate limit exceeded"
    exit 1
  fi
  BEHAVIOR="${MOCK_RATELIMIT_THEN:-fail}"
fi

# --- Hang behavior (for timeout testing) ---
if [[ "$BEHAVIOR" == "hang" ]]; then
  sleep 3600
  exit 0
fi

# --- Phase detection ---
if [[ "$ALLOWED_TOOLS" == *"mcp__plugin_serena"* ]] && [[ "$ALLOWED_TOOLS" != *"Edit"* ]]; then
  PHASE="read"
elif [[ "$ALLOWED_TOOLS" == *"Edit Write Bash"* ]] && [[ "$ALLOWED_TOOLS" != *"mcp__plugin_serena"* ]]; then
  PHASE="write"
elif [[ "$ALLOWED_TOOLS" == *"Edit"* ]] && [[ "$ALLOWED_TOOLS" == *"mcp__plugin_serena"* ]]; then
  PHASE="verify"
else
  PHASE="unknown"
fi

# --- Helper: project root for serena_init ---
ACTUAL_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "/unknown")"

# --- Helper: pass the next incomplete story ---
pass_next_story() {
  if [ -n "$MOCK_PRD_FILE" ] && [ -f "$MOCK_PRD_FILE" ]; then
    NEXT_ID=$(jq -r '[.userStories[] | select(.passes != true)] | sort_by(.priority) | .[0].id // empty' "$MOCK_PRD_FILE")
    if [ -n "$NEXT_ID" ]; then
      jq --arg id "$NEXT_ID" '(.userStories[] | select(.id == $id)).passes = true' "$MOCK_PRD_FILE" > "$MOCK_PRD_FILE.tmp"
      mv "$MOCK_PRD_FILE.tmp" "$MOCK_PRD_FILE"
      echo "Verified $NEXT_ID: all criteria passed."
    fi
  fi
}

# --- Output based on phase + behavior ---
case "$PHASE" in
  read)
    # Emit serena sentinel if requested
    case "$BEHAVIOR" in
      serena_init_match)    echo "[SERENA_INIT: $ACTUAL_ROOT]" ;;
      serena_init_mismatch) echo "[SERENA_INIT: /wrong/path]" ;;
    esac
    # Emit context — either verbose (MOCK_READ_LINES) or structured default
    if [ -n "$MOCK_READ_LINES" ] && [ "$MOCK_READ_LINES" -gt 0 ]; then
      for i in $(seq 1 "$MOCK_READ_LINES"); do
        echo "- symbol_$i: /src/file_$i.ts line $i"
      done
    else
      echo "### Relevant Files"
      echo "- src/main.ts: Main entry point"
      echo ""
      echo "### Key Symbols"
      echo "- function main(): entry point"
      echo ""
      echo "### Code Snippets"
      echo "No specific snippets needed."
      echo ""
      echo "### Implementation Notes"
      echo "Follow existing patterns."
    fi
    ;;

  write)
    echo "Write phase output"
    ;;

  verify)
    case "$BEHAVIOR" in
      pass)
        echo "Ralph verify phase: checking acceptance criteria..."
        pass_next_story
        ;;
      serena_init_match)
        echo "[SERENA_INIT: $ACTUAL_ROOT]"
        echo "Ralph verify phase: checking acceptance criteria..."
        pass_next_story
        ;;
      serena_init_mismatch)
        echo "[SERENA_INIT: /wrong/path]"
        echo "Verification failed: criteria not met."
        ;;
      mutate)
        if [ -n "$MOCK_PRD_FILE" ] && [ -f "$MOCK_PRD_FILE" ]; then
          jq '(.userStories[0]).title = "MUTATED TITLE"' "$MOCK_PRD_FILE" > "$MOCK_PRD_FILE.tmp"
          mv "$MOCK_PRD_FILE.tmp" "$MOCK_PRD_FILE"
        fi
        echo "Verification done."
        ;;
      multi-pass)
        if [ -n "$MOCK_PRD_FILE" ] && [ -f "$MOCK_PRD_FILE" ]; then
          jq '(.userStories[] | select(.passes != true)).passes = true' "$MOCK_PRD_FILE" > "$MOCK_PRD_FILE.tmp"
          mv "$MOCK_PRD_FILE.tmp" "$MOCK_PRD_FILE"
        fi
        echo "All stories passed."
        ;;
      revert)
        if [ -n "$MOCK_PRD_FILE" ] && [ -f "$MOCK_PRD_FILE" ]; then
          jq '(.userStories[] | select(.passes == true)).passes = false' "$MOCK_PRD_FILE" > "$MOCK_PRD_FILE.tmp"
          mv "$MOCK_PRD_FILE.tmp" "$MOCK_PRD_FILE"
        fi
        echo "Reverted stories."
        ;;
      corrupt)
        if [ -n "$MOCK_PRD_FILE" ] && [ -f "$MOCK_PRD_FILE" ]; then
          echo "NOT VALID JSON!!!" > "$MOCK_PRD_FILE"
        fi
        echo "Corrupted."
        ;;
      *)
        echo "Verification failed: criteria not met."
        ;;
    esac
    ;;

  *)
    echo "Unknown phase"
    ;;
esac
